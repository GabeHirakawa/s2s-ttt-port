{
  "name": "@edgegamers/ttt",
  "version": "0.1.0",
  "private": true,
  "main": "src/plugin.ts",
  "scripts": {
    "build": "s2s build ."
  },
  "devDependencies": {
    "@s2script/cs2": "^0.11.1",
    "@s2script/eslint-plugin": "^0.2.0",
    "@s2script/sdk": "^0.11.0",
    "eslint": "^10.7.0"
  },
  "s2script": {
    "id": "ttt",
    "game": "cs2",
    "config": {
      "phrases_file": {
        "type": "string",
        "default": ""
      }
    },
    "gamedata": "gamedata/ttt.gamedata.jsonc",
    "permissions": [
      "engine:calls"
    ]
  },
  "description": "Trouble in Terrorist Town for CS2 — an s2script port of edgegamers/TTT"
}
